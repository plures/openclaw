+/**
+ * Merge process-local open incognito stores into a durable store projection.
+ *
+ * Worker threads cannot see the main thread's registry of currently-open incognito
+ * databases, so async durable materialization deliberately excludes them and calls
+ * this helper after the worker result returns.
+ */
+export function mergeOpenIncognitoSessionStoresForGateway(
+  cfg: OpenClawConfig,
+  result: GatewayCombinedSessionStoreResult,
+  opts: GatewaySessionStoreOptions = {},
+): GatewayCombinedSessionStoreResult {
+  if (opts.includeIncognito === false) {
+    return result;
+  }
+
+  const projection = opts.projection ?? "full";
+  const resolved = resolveGatewaySessionStoreTargets(cfg, opts);
+  if (resolved.incognitoTargets.length === 0) {
+    return result;
+  }
+
+  const combined = { ...result.store };
+  const incognitoStorePaths = mergeOpenIncognitoStores({
+    cfg,
+    combined,
+    projection,
+    targets: resolved.incognitoTargets,
+  });
+  if (incognitoStorePaths.length === 0) {
+    return result;
+  }
+
+  return {
+    ...result,
+    storePath: resolveCombinedStorePath(
+      [...resolved.durableTargets.map((target) => target.storePath), ...incognitoStorePaths],
+      resolved.storeConfig,
+    ),
+    store: combined,
+  };
+}
